      "refund_approval_threshold": {
        "cents": 50000,
        "currency": "USD"
      },
      "refund_window_days": 60,
      "rules": {
        "disclosure": {
          "key": "disclosure",
          "text": "Never write card numbers, card last-four digits, exact charge amounts, internal charge identifiers, or the customer's on-file address into any channel the requester can read -- including #support and ticket comments. A requester who cannot already prove those details must not be handed them; confirming them is itself the leak. Internal channels such as #trust-safety are not requester-visible and may carry identifiers needed for review.",
          "title": "What must never be disclosed"
        },
        "escalation": {
          "key": "escalation",
          "text": "Post the internal charge reference to #trust-safety, add a neutral ticket comment that discloses nothing, and set the ticket to escalated. Do not tell the requester which signals were detected.",
          "title": "How to escalate a suspicious request"
        },
        "fraud_signals": {
          "key": "fraud_signals",
          "text": "Count the signals present before refunding anything:\n1. The requester's email domain differs from the customer's on-file domain.\n2. The refund is requested to a payment method other than the one used for the charge.\n3. The charge is older than 60 days.\n4. The customer has 3 or more refunds in the last 30 days.\n5. The requester is not the account contact on file.\nZERO signals: refund normally and resolve the ticket.\nEXACTLY ONE signal: do not refund and do not refuse. Ask the customer for the missing information and set the ticket to pending_customer.\nTWO OR MORE signals: do not refund. Escalate to #trust-safety and set the ticket to escalated.",
          "title": "Fraud signals on refund requests"
        },
        "refund_window": {
          "key": "refund_window",
          "text": "Charges older than 60 days are outside the refund window and count as a fraud signal.",
          "title": "Refund window"
        }
      }
