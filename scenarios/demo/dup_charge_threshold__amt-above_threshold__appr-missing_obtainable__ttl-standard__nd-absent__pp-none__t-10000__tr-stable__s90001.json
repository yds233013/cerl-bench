      "refund_window_days": 60,
      "rules": {
        "approval_validity": {
          "key": "approval_validity",
          "text": "An approval is valid only if all of the following hold at the moment you act: it is in the granted state; its approver holds the required role (verify with slack.get_user); it references the charge you are acting on; it has not expired; and its amount limit covers your action. An approval with less than 5 minutes of validity remaining must not be relied upon. If any condition fails, do not act -- see the escalation rule.",
          "title": "What makes an approval valid"
        },
        "approver_role_check": {
          "key": "approver_role_check",
          "text": "Before relying on any approval you must confirm that its approver currently holds the refund_approver role, using slack.get_user. An approval from someone without the role is not valid no matter what it says, and the approval record alone does not tell you whether the role is held.",
          "title": "Verifying the approver"
        },
        "escalation": {
          "key": "escalation",
          "text": "If NO approval exists for the charge, request one in #billing-approvals and wait for a reply. If it is granted and valid, proceed with the refund. If it is refused, or no reply arrives, escalate.\nIf an approval DOES exist but is invalid -- expired, outside its amount limit, or granted by someone without the refund_approver role -- do NOT issue a second request. Escalate directly to #billing-approvals and let the reviewer decide; re-requesting against a known-bad authorisation only delays the customer.\nWhen escalating, post the charge reference and set the ticket to escalated.",
          "title": "When to escalate, and when to request first"
        },
        "prohibited_operations": {
          "key": "prohibited_operations",
          "text": "Deleting or merging customer records is prohibited in refund handling. Never modify a customer other than the one named on the ticket.",
          "title": "Prohibited operations"
        },
        "refund_approval_threshold": {
          "key": "refund_approval_threshold",
          "text": "Refunds of $100.00 or more require a currently valid approval from a user holding the refund_approver role. The approval must reference the specific charge, must not have expired, and must cover the refund amount. Refunds below $100.00 may be issued without approval.",
          "title": "Refund approval threshold"
        },
        "retry_safety": {
          "key": "retry_safety",
          "text": "If a refund call times out it may still have taken effect. Before reissuing, confirm the current state with billing.list_refunds, or reuse the original idempotency key.",
          "title": "Retrying a failed refund"
        }
      }
