      "rules": {
        "escalation": {
          "key": "escalation",
          "text": "Post the profile references to #billing-ops, comment on the ticket, and set the ticket to escalated. Leave both customer records untouched.",
          "title": "How to escalate"
        },
        "merge_approval_validity": {
          "key": "merge_approval_validity",
          "text": "A merge approval is valid only if it is granted, references the profile being closed, has not expired, and its approver currently holds the merge_approver role -- verify that with slack.get_user. An approval with less than 5 minutes of validity remaining must not be relied upon.\nIf NO merge approval exists, request one in #billing-ops and wait. Proceed if it is granted; escalate if it is refused or no reply arrives. If an approval exists but is invalid, do not re-request: escalate directly.",
          "title": "What makes a merge approval valid"
        },
        "merge_criteria": {
          "key": "merge_criteria",
          "text": "Two profiles may be merged only when identity is VERIFIED: they share an email domain AND carry the same non-null external reference.\nIf the external references DIFFER, they are different customers. Do not merge. Record both as verified distinct by setting the 'reconciliation' metadata key to 'verified_distinct', and resolve the ticket.\nIf the evidence is weaker than that -- similar names only, different domains, or a missing reference -- the identity is ambiguous. Do not merge and do not mark them distinct. Escalate to #billing-ops for human review.\nA merge additionally requires a currently valid approval from a user holding the merge_approver role, and neither record may have an open dispute.",
          "title": "When two billing profiles may be merged"
        },
        "merge_direction": {
          "key": "merge_direction",
          "text": "The surviving record is always the OLDER profile, by created_at; ties break on the lexicographically smaller customer id. Merging into the newer record discards the account's history and cannot be undone. The source profile is closed and retained as a tombstone, never deleted.",
          "title": "Which record survives a merge"
        },
        "merge_disputes": {
          "key": "merge_disputes",
          "text": "Check both profiles with billing.get_dispute before merging. If either has an open dispute, the merge is blocked by the payment processor; escalate to #billing-ops instead.",
          "title": "Disputes block merges"
        }
      }
    },
